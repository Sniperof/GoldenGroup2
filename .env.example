# ============================================================
# Golden CRM — Environment Variables Template
# ============================================================
# 1. انسخ هذا الملف وسمّه .env
# 2. عبّئ القيم الفعلية — لا ترفع الملف على GitHub أبداً
# ============================================================

# ── قاعدة البيانات ──────────────────────────────────────────
# إذا استخدمت postgres من docker-compose استخدم:
#   DATABASE_URL=postgresql://golden:PASSWORD@db:5432/golden_crm
# إذا كانت قاعدة البيانات خارجية ضع عنوانها مباشرة:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ── PostgreSQL (خاص بـ docker-compose فقط) ─────────────────
# يُستخدم فقط عندما تعتمد على حاوية db الداخلية
POSTGRES_DB=golden_crm
POSTGRES_USER=golden
POSTGRES_PASSWORD=change_me_strong_password

# ── بيئة التشغيل ────────────────────────────────────────────
NODE_ENV=production

# ── JWT Secret (مفتاح تشفير الجلسات) ───────────────────────
# أنشئ مفتاحاً عشوائياً: openssl rand -hex 32
JWT_SECRET=your_super_secret_key_here

# ── بورت التطبيق على الهوست (shared nginx يبروكسي له) ──────
APP_PORT=3880

# ── CORS (نطاقات مسموح بها من الفرونتإند) ──────────────────
# مثال: CORS_ORIGINS=https://crm.example.com,https://www.example.com
CORS_ORIGINS=

# ── مسار ملفات الرفع (اختياري) ─────────────────────────────
# الافتراضي /app/uploads داخل الحاوية — غيّره إن أردت تخصيصه
# UPLOADS_DIR=/app/uploads

# ── مخزن الوسائط الموحّد (صور الأجهزة والفروع والبانرات) ────
# إلزامي في الإنتاج، ويجب أن يكون خارج مجلد الكود حتى لا يُمحى مع كل نشر،
# وضمن النسخ الاحتياطي. الافتراضي <repo>/media للتطوير المحلي فقط.
# MEDIA_DIR=/var/lib/golden-crm/media

# ── الوسيط العكسي (إلزامي خلف nginx) ───────────────────────
# يحدّد كيف يستخرج Express عنوان العميل (req.ip)، وعليه تقوم حدود
# الطلبات العامة. بدونه يبدو كل نداء قادماً من 127.0.0.1 فتنهار
# الحدود في دلو واحد مشترك للإنترنت كله.
TRUST_PROXY=1

# ── OTP تطبيق الزبائن (DEC-013 §6) ─────────────────────────
# fail-closed: قيمة مجهولة توقف الإقلاع، و'simulated' مرفوضة في
# الإنتاج (لا تُسلّم أي رسالة وتطبع الرموز في السجلّ).
OTP_PROVIDER=simulated
# OTP_TTL_SECONDS=120
# OTP_RESEND_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_CODE_LENGTH=6
# سقف رسائل التحقق لرقم واحد خلال 24 ساعة عبر كل الأغراض (0 = تعطيل)
OTP_DAILY_CAP_PER_PHONE=10

# ── مزوّد Rasel (مطلوب فقط عند OTP_PROVIDER=sms) ───────────
# لا تضع مفتاحاً حقيقياً هنا أو في أي ملف env مُدرَج بالـ git.
# OTP_PROVIDER=sms
# RASEL_BASE_URL=https://raselsms.com
# RASEL_SEND_PATH=/api/v2/messages/send
# RASEL_API_KEY=
# RASEL_CHANNEL=local_sms
# RASEL_SENDER_ID=
# RASEL_TIMEOUT_MS=10000
# RASEL_TRIAL_MODE=true
# RASEL_TRIAL_ALLOWED_TO=963987223900
# RASEL_KILL_SWITCH=false

# ── توكنات تطبيق الزبائن ───────────────────────────────────
# APP_ACCESS_TTL=60m
# APP_REFRESH_TTL_DAYS=60

# ── حدود السطح العام للموبايل (لكل عنوان IP، 0 = تعطيل) ────
# APP_RATE_LIMIT_ENABLED=true            # false يعطّل الحدود كلها (اختبار الحمل فقط)
# APP_RATE_OTP_SEND=5                    # نافذة APP_RATE_OTP_SEND_WINDOW_S=600
# APP_RATE_OTP_VERIFY=20                 # نافذة APP_RATE_OTP_VERIFY_WINDOW_S=600
# APP_RATE_MUTATION=30                   # نافذة APP_RATE_MUTATION_WINDOW_S=600
# APP_RATE_INTAKE=10                     # نافذة APP_RATE_INTAKE_WINDOW_S=3600
# APP_RATE_READ=120                      # نافذة APP_RATE_READ_WINDOW_S=60

# ── سقوف استقبال طلبات الموبايل (لكل هوية، محفوظة في قاعدة البيانات) ──
# APP_WATER_CHECK_OPEN_PER_PHONE=1       # طلبات فحص مياه مفتوحة لرقم المستفيد
# APP_WATER_CHECK_DAILY_PER_REQUESTER=5  # طلبات من هوية واحدة خلال 24 ساعة
# APP_SUBMITTED_PAYLOAD_MAX_CHARS=8000   # سقف الحمولة المخزَّنة (محارف JSON)
